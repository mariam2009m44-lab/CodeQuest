{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "README.md",
      "**/*.md",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      ".git/**",
      ".env",
      ".env.*"
    ],
    "cleanUrls": false
  }
}