{
  "name": "cody-academy-functions",
  "description": "Backend functions for Cody Academy",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "cd .. && firebase emulators:start --only functions",
    "deploy": "cd .. && firebase deploy --only functions,firestore:rules",
    "logs": "cd .. && firebase functions:log",
    "test": "node --test tests/*.test.cjs",
    "test:unit": "node --test tests/parent-progress-integrity.test.cjs tests/reward-integrity.test.cjs",
    "test:emulator": "node --test tests/reward-emulator.test.cjs"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0"
  }
}
