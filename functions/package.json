{
  "name": "cody-academy-functions",
  "description": "Backend functions for Cody Academy",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "cd .. && firebase emulators:start --only functions",
    "deploy": "cd .. && firebase deploy --only functions,firestore:rules",
    "logs": "cd .. && firebase functions:log",
    "test": "node --test tests/*.test.cjs",
    "check": "cd .. && node scripts/validate-js-syntax.mjs && node scripts/validate-curricula.mjs && node scripts/validate-dashboard-media.mjs && cd functions && npm test"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0"
  }
}
