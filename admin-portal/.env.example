# Copy values into your hosting provider's environment settings; never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-admin-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-admin-domain.example

# Prefer a managed PostgreSQL DATABASE_URL for production.
# Leave DATABASE_URL unset for local SQLite development.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Enable these only after HTTPS and proxy settings are confirmed.
DJANGO_SECURE_COOKIES=true
DJANGO_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=3600

# Firebase student lookup is disabled by default.
# Enable only after assigning a read-only Firestore IAM role to the runtime identity.
FIREBASE_ADMIN_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
# On local development, point GOOGLE_APPLICATION_CREDENTIALS to a secret file
# outside the repository. In production, prefer workload identity / ADC.
