// CodeQuest - Curriculum Loader
// Loads the existing curriculum JSON files.

const CURRICULUM_FILES = {
  python: "json/python_curriculum.json",
  javascript: "json/js_curriculum.json",
  cpp: "json/cpp_curriculum.json",
};

const curriculumCache = new Map();

/**
 * Load the curriculum for a programming language.
 * @param {"python" | "javascript" | "cpp"} language
 * @returns {Promise<Object|Array>}
 */
export async function loadCurriculum(language) {
  const filePath = CURRICULUM_FILES[language];

  if (!filePath) {
    throw new Error(`Unsupported programming language: ${language}`);
  }

  if (curriculumCache.has(language)) {
    return curriculumCache.get(language);
  }

  const response = await fetch(filePath);

  if (!response.ok) {
    throw new Error(
      `Failed to load curriculum: ${filePath} (HTTP ${response.status})`
    );
  }

  const curriculum = await response.json();

  curriculumCache.set(language, curriculum);

  return curriculum;
}

/**
 * Clear the cached curriculum.
 * @param {"python" | "javascript" | "cpp"} language
 */
export function clearCurriculumCache(language) {
  curriculumCache.delete(language);
}