        "lessons_data": {
            "1": {
                "title": "ما هي البرمجة؟",
                "intro": "مرحباً بك! البرمجة هي لغة التخاطب مع الكمبيوتر. سنتعلم كيف نعطيه أوامر لتنفيذ مهام رائعة.",
                "code": ""
            },
            "2": {
                "title": "أول كود",
                "intro": "لنطبع رسالة على الشاشة! نستخدم الأمر console.log",
                "code": "console.log(\"مرحباً بالعالم!\");",
                "hint": "ضع النص بين علامات التنصيص"
            },
            "3": {
                "title": "التعليقات",
                "intro": "التعليقات هي ملاحظات يقرأها المبرمج ولا ينفذها الكمبيوتر. نكتبها بـ //",
                "code": "// هذا تعليق\nconsole.log(\"Hello\");",
                "hint": "اكتب // قبل أي جملة لتتحول لتعليق"
            },
            "4": {
                "title": "تعريف المتغيرات",
                "intro": "المتغير هو صندوق نخزن فيه البيانات (مثل الأرقام أو النصوص) لنستخدمه لاحقاً. نستخدم let",
                "code": "let name = \"Cody\";\nconsole.log(name);",
                "hint": "اسم المتغير لا يحتوي على مسافات"
            },
            "5": {
                "title": "تطبيق المتغيرات",
                "intro": "اكتب متغيراً باسم age وضع فيه رقم 10.",
                "code": "let age = 10;\nconsole.log(age);",
                "hint": "اكتب 10 بدون علامات تنصيص لأنه رقم"
            },
            "6": {
                "title": "الجمع والطرح",
                "intro": "يمكننا استخدام + للجمع و - للطرح.",
                "code": "let x = 10 + 5;\nconsole.log(x);",
                "hint": "الناتج سيكون 15"
            },
            "7": {
                "title": "الضرب والقسمة",
                "intro": "نستخدم * للضرب و / للقسمة.",
                "code": "let y = 10 * 2;\nconsole.log(y);",
                "hint": "10 ضرب 2 يساوي 20"
            },
            "8": {
                "title": "جملة if",
                "intro": "عندما نريد اتخاذ قرار في الكود، نستخدم if. إذا تحقق الشرط، يتم تنفيذ الكود.",
                "code": "if (5 > 3) {\n  console.log(\"صح\");\n}",
                "hint": "الشرط بين القوسين"
            },
            "9": {
                "title": "تطبيق if",
                "intro": "اكتب شرطاً يتحقق إذا كان الرقم أكبر من 5.",
                "code": "let x = 10;\nif (x > 5) {\n  console.log(\"أكبر\");\n}",
                "hint": "استخدم علامة < أو >"
            },
            "10": {
                "title": "جملة else",
                "intro": "إذا لم يتحقق الشرط، يمكننا استخدام else لتنفيذ كود آخر.",
                "code": "let age = 15;\nif (age >= 18) {\n  console.log(\"بالغ\");\n} else {\n  console.log(\"صغير\");\n}",
                "hint": "جرب تغيير 15 لـ 20"
            }
        }
    },
