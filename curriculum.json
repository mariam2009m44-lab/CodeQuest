        "lessons_data": {
            "1": {
                "title": "ما هي البرمجة؟",
                "intro": "مرحباً بك يا بطل! البرمجة هي طريقة لإعطاء أوامر للكمبيوتر ليقوم بمهام رائعة، مثل صناعة الألعاب أو المواقع. تخيل أنك القائد والكمبيوتر هو الجندي الذي ينفذ أوامرك!",
                "code": ""
            },
            "2": {
                "title": "أول كود لك",
                "intro": "حان وقت التجربة! سنستخدم الأمر console.log لنطبع جملة على الشاشة.",
                "code": "console.log(\"مرحباً بالعالم!\");",
                "hint": "ضع النص بين علامات التنصيص \" \" "
            },
            "3": {
                "title": "التعليقات",
                "intro": "التعليقات هي ملاحظات نكتبها لأنفسنا ولا ينفذها الكمبيوتر. نكتبها بعلامة //",
                "code": "// هذا تعليق\nconsole.log(\"Hello\");",
                "hint": "اكتب // قبل أي جملة لتتحول لتعليق"
            },
            "4": {
                "title": "صناديق البيانات",
                "intro": "المتغير هو مثل الصندوق، نضع فيه الأشياء لنستخدمها لاحقاً. في البرمجة نستخدم let لصنع الصندوق.",
                "code": "let name = \"Cody\";\nconsole.log(name);",
                "hint": "اسم المتغير لا يحتوي على مسافات"
            },
            "5": {
                "title": "تطبيق المتغيرات",
                "intro": "اكتب متغيراً باسم age وضع فيه رقم 10.",
                "code": "let age = 10;\nconsole.log(age);",
                "hint": "اكتب 10 بدون علامات تنصيص لأنه رقم"
            },
            "6": {
                "title": "جملة if",
                "intro": "عندما نريد اتخاذ قرار، نستخدم if. إذا تحقق الشرط، ينفذ الكود.",
                "code": "if (5 > 3) {\n  console.log(\"صح\");\n}",
                "hint": "الشرط بين القوسين"
            },
            "7": {
                "title": "تطبيق if",
                "intro": "اكتب شرطاً يتحقق إذا كان الرقم أكبر من 5.",
                "code": "let x = 10;\nif (x > 5) {\n  console.log(\"أكبر\");\n}",
                "hint": "استخدم علامة >"
            }
        }
    },
