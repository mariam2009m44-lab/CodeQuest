rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // قواعد صارمة للمستخدمين
    match /users/{userId} {
      // أي حد مسجل دخول يقدر يقرأ بيانات المستخدمين (للوحة الشرف والبروفايل)
      allow read: if request.auth != null;
      
      // المستخدم يقدر يكتب في ملفه الشخصي فقط، وبشروط معينة
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.data.username is string
                   && request.resource.data.points >= 0; // منع النقاط السالبة
                   
      // منع تعديل نقاط المستخدمين الآخرين أو إعطاء صلاحيات أدمن
      allow update: if request.auth != null 
                    && request.auth.uid == userId 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']);
    }
  }
}
