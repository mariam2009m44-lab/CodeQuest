rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. قواعد بيانات المستخدمين (محمية جداً)
    // كل مستخدم يقدر يقرأ ويكتب في بياناته هو بس
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 2. قواعد المناهج والدروس (قراءة فقط للجميع)
    // ممنوع أي مستخدم يعدل أو يمسح الدروس من المتصفح
    match /curriculum/{document=**} {
      allow read: if true;
      allow write: if false; 
    }
    
    // 3. قواعد النتائج والتقدم (Progress)
    match /progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 4. قاعدة افتراضية تمنع أي وصول تاني (Zero Trust)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
