
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validLanguage(language) {
      return language in ['python', 'javascript', 'cpp', 'java'];
    }

    function validAvatarSelection(data) {
      return !data.keys().hasAny(['activeAvatar'])
        || data.activeAvatar in [
          'cody', 'layla', 'omar', 'sara', 'robo', 'nova', 'yazan', 'malak'
        ]
        || (
          data.activeAvatar == 'astronaut'
          && data.inventory is list
          && data.inventory.hasAny(['astronaut'])
        )
        || (
          data.activeAvatar == 'fox'
          && data.inventory is list
          && data.inventory.hasAny(['fox'])
        )
        || (
          data.activeAvatar == 'robot'
          && data.inventory is list
          && data.inventory.hasAny(['robot'])
        )
        || (
          data.activeAvatar == 'dragon'
          && data.inventory is list
          && data.inventory.hasAny(['dragon'])
        );
    }

    function validProfile(uid) {
      let data = request.resource.data;
      let progress = data.languageProgress;

      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'xp',
          'stars',
          'coins',
          'level',
          'completedLessons',
          'completedProjects',
          'streak',
          'languageProgress',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'xp',
          'stars',
          'coins',
          'level',
          'completedLessons',
          'completedProjects',
          'streak',
          'languageProgress',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 50
        && data.email is string
        && data.xp == 0
        && data.stars == 0
        && data.coins == 0
        && data.level == 1
        && data.completedLessons == 0
        && data.completedProjects == 0
        && data.streak == 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && progress is map
        && progress.keys().hasAll([
          'python',
          'javascript',
          'cpp',
          'java'
        ])
        && progress.keys().hasOnly([
          'python',
          'javascript',
          'cpp',
          'java'
        ])
        && progress.python is number
        && progress.python >= 0
        && progress.python <= 100
        && progress.javascript is number
        && progress.javascript >= 0
        && progress.javascript <= 100
        && progress.cpp is number
        && progress.cpp >= 0
        && progress.cpp <= 100
        && progress.java is number
        && progress.java >= 0
        && progress.java <= 100;
    }

    match /users/{uid} {
      allow get: if owns(uid);
      allow list: if false;

      allow create: if owns(uid) && validProfile(uid);

      allow update: if owns(uid)
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'currentLang',
            'knowledge',
            'onboardingComplete',
            'weeklyGoal',
            'theme',
            'notifications',
            'activeAvatar',
            'updatedAt'
          ])
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['displayName'])
          || (
            request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 2
            && request.resource.data.displayName.size() <= 50
          )
        )
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt is timestamp
        )
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['activeAvatar'])
          || validAvatarSelection(request.resource.data)
        );

      allow delete: if false;

      match /studioEvidence/{evidenceId} {
        allow read, write: if false;
      }

      match /lessonProgress/{lessonId} {
        function hasVerifiedQuizResult(uid, data) {
          // A rules path can interpolate a whole segment, not fragments of it.
          let resultId = 'lesson_' + data.language + '_' + string(data.chapter) + '_' + string(data.lesson);
          let resultPath = /databases/$(database)/documents/users/$(uid)/quizResults/$(resultId);

          return exists(resultPath)
            && get(resultPath).data.verificationVersion == 1
            && get(resultPath).data.serverVerified == true
            && get(resultPath).data.passed == true
            && get(resultPath).data.uid == uid
            && get(resultPath).data.language == data.language
            && get(resultPath).data.chapter == data.chapter
            && get(resultPath).data.lesson == data.lesson
            && (
              data.language != 'java'
              || (
                get(resultPath).data.challengeVerified == true
                && get(resultPath).data.quizVerified == true
              )
            );
        }

        function validLessonProgress() {
          let data = request.resource.data;

          return data.keys().hasAll([
              'language',
              'chapter',
              'lesson',
              'completed',
              'updatedAt'
            ])
            && data.keys().hasOnly([
              'language',
              'chapter',
              'lesson',
              'completed',
              'updatedAt'
            ])
            && validLanguage(data.language)
            && data.chapter is int
            && data.chapter >= 0
            && data.lesson is int
            && data.lesson >= 0
            && data.completed is bool
            && data.updatedAt is timestamp;
        }

        allow get, list: if owns(uid);
        allow create, update: if owns(uid)
          && validLessonProgress()
          && (
            request.resource.data.completed != true
            || hasVerifiedQuizResult(uid, request.resource.data)
          );
        allow delete: if owns(uid);
      }

      match /codyMessages/{messageId} {
        allow get, list: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.keys().hasAll(['role', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly([
            'role',
            'text',
            'imageData',
            'createdAt'
          ])
          && request.resource.data.role in ['user', 'model']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          && request.resource.data.createdAt is timestamp
          && (
            !request.resource.data.keys().hasAny(['imageData'])
            || (
              request.resource.data.imageData is string
              && request.resource.data.imageData.size() <= 520000
              && request.resource.data.imageData.matches('^data:image/(jpeg|png|webp);base64,')
              && request.resource.data.role == 'user'
            )
          );
        allow update: if false;
        allow delete: if owns(uid);
      }

      match /quizResults/{resultId} {
        allow read: if owns(uid);
        allow write: if false;
      }

      match /gameRewards/{gameId} {
        allow read: if owns(uid);
        allow write: if false;
      }

      match /drafts/{draftId} {
        allow read, delete: if owns(uid);

        allow create, update: if owns(uid)
          && request.resource.data.keys().hasOnly([
            'code',
            'language',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'code',
            'updatedAt'
          ])
          && request.resource.data.code is string
          && request.resource.data.code.size() <= 50000
          && request.resource.data.updatedAt is timestamp
          && (
            !request.resource.data.keys().hasAny(['language'])
            || validLanguage(request.resource.data.language)
          );
      }
    }

    match /liveClasses/{classId} {
      // Class metadata is public only to signed-in CodeQuest users.
      // Provider meeting IDs and API credentials live in liveClassPrivate.
      allow get, list: if signedIn()
        && (
          resource.data.status in ['scheduled', 'live']
          || resource.data.instructorUid == request.auth.uid
        );
      allow create, update, delete: if false;

      match /enrollments/{uid} {
        allow get: if owns(uid)
          || (
            signedIn()
            && request.auth.token.liveRole == 'instructor'
            && get(/databases/$(database)/documents/liveClasses/$(classId)).data.instructorUid == request.auth.uid
          );
        allow list: if signedIn()
          && request.auth.token.liveRole == 'instructor'
          && request.auth.token.liveInstructorApproved == true
          && get(/databases/$(database)/documents/liveClasses/$(classId)).data.instructorUid == request.auth.uid;
        allow create, update, delete: if false;
      }

      match /workspace/{workspaceId} {
        function classRecord() {
          return get(/databases/$(database)/documents/liveClasses/$(classId)).data;
        }
        function isClassInstructor() {
          return signedIn() && classRecord().instructorUid == request.auth.uid
            && request.auth.token.liveRole == 'instructor'
            && request.auth.token.liveInstructorApproved == true;
        }
        function isClassAdmin() {
          return signedIn() && (request.auth.token.liveRole == 'admin' || request.auth.token.admin == true);
        }
        function isEnrolledStudent() {
          let enrollmentPath = /databases/$(database)/documents/liveClasses/$(classId)/enrollments/$(request.auth.uid);
          return signedIn() && exists(enrollmentPath) && get(enrollmentPath).data.status == 'enrolled';
        }
        function canUseWorkspace() {
          return isClassInstructor() || isClassAdmin() || isEnrolledStudent();
        }
        allow get: if workspaceId == 'shared' && canUseWorkspace();
        allow list: if false;
        allow create: if workspaceId == 'shared' && isClassInstructor()
          && request.resource.data.keys().hasOnly(['code', 'language', 'updatedBy', 'updatedAt'])
          && request.resource.data.keys().hasAll(['code', 'language', 'updatedBy', 'updatedAt'])
          && request.resource.data.code is string && request.resource.data.code.size() <= 50000
          && request.resource.data.language in ['python', 'javascript', 'cpp', 'java']
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt is timestamp;
        allow update: if workspaceId == 'shared' && canUseWorkspace()
          && request.resource.data.keys().hasOnly(['code', 'language', 'updatedBy', 'updatedAt'])
          && request.resource.data.keys().hasAll(['code', 'language', 'updatedBy', 'updatedAt'])
          && request.resource.data.code is string && request.resource.data.code.size() <= 50000
          && request.resource.data.language in ['python', 'javascript', 'cpp', 'java']
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt is timestamp
          && (request.resource.data.language == resource.data.language || isClassInstructor() || isClassAdmin());
        allow delete: if false;
      }
    }

    match /liveClassPrivate/{classId} {
      allow read, write: if false;
    }

    match /liveInstructorApprovals/{uid} {
      allow read, write: if false;
    }

    match /projects/{projectId} {
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 50000
        && validLanguage(request.resource.data.language);

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'language',
            'code',
            'date',
            'updatedAt'
          ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 50000
        && validLanguage(request.resource.data.language);
    }

    match /leaderboardPublic/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
