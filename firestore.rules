
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if owns(uid);
      allow list: if false;

      allow create: if owns(uid)
        && request.resource.data.xp == 0
        && request.resource.data.coins == 0;

      allow update: if owns(uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'currentLang',
            'knowledge',
            'onboardingComplete',
            'weeklyGoal',
            'theme',
            'notifications',
            'activeAvatar',
            'updatedAt'
          ]);

      allow delete: if false;

      match /quizResults/{resultId} {
        allow read: if owns(uid);
        allow write: if false;
      }

      match /gameRewards/{gameId} {
        allow read: if owns(uid);
        allow write: if false;
      }

      match /drafts/{draftId} {
        allow read, delete: if owns(uid);

        allow create, update: if owns(uid)
          && request.resource.data.code is string
          && request.resource.data.code.size() <= 50000;
      }
    }

    match /projects/{projectId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
